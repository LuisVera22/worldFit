<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - WorldFit</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm">
        <div class="container">
            
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index","Home")">
                <img src="~/Content/img/wordlfit_logo.png" alt="WorldFit" width="40" height="40" class="me-2 rounded-circle" />
                <span class="fw-bold">WorldFit</span>
            </a>

            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENÚ -->
            <!--<div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
            <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Usuario", null, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Registro", "Registro", "Usuario", null, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Login", "Login", "Usuario", null, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", null, new { @class = "nav-link" })</li>
            <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", null, new { @class = "nav-link" })</li>
        </ul>
    </div>-->
            <!-- MENÚ -->
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>

                    @if (Session["UsuarioID"] != null)
                    {
                        <!-- Usuario logueado -->
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Perfil", "Usuario")">
                                Mi Cuenta (@Session["UsuarioNombre"])
                            </a>
                        </li>

                    }
                    else
                    {
                        <!-- Usuario no logueado -->
                        <li class="nav-item">@Html.ActionLink("Registro", "Registro", "Usuario", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Login", "Login", "Usuario", null, new { @class = "nav-link" })</li>
                    }
                    <li class="nav-item">@Html.ActionLink("IMC", "Calculadora", "Calculadora", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Macros", "Macros", "Calculadora", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Calorías", "Calorias", "Calculadora", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", null, new { @class = "nav-link" })</li>
                </ul>
            </div>

        </div>
    </nav>

    
    <div class="container mt-4">
        @RenderBody()
        <hr />
        <footer class="text-center text-muted">
            <p>&copy; @DateTime.Now.Year - WorldFit | Tu salud, tu estilo de vida 💪</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>