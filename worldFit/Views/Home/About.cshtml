@{
    ViewBag.Title = "Acerca de WorldFit";
}

<div class="container mt-5">
    
    <div class="text-center mb-5">
        <h1 class="fw-bold text-success">🌍 Acerca de <span class="text-dark">WorldFit</span></h1>
        <p class="lead text-muted">Tu compañero digital para lograr un estilo de vida saludable</p>
    </div>

    
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-primary">💡 Misión</h3>
                    <p class="card-text">
                        Ayudar a las personas a transformar sus hábitos con rutinas, planes de alimentación
                        y seguimiento de salud accesible desde cualquier lugar.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-warning">🎯 Visión</h3>
                    <p class="card-text">
                        Ser la aplicación fitness más confiable en Latinoamérica, motivando a miles de usuarios
                        a alcanzar sus objetivos físicos y emocionales.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title text-success">🏆 Objetivos</h3>
                    <p class="card-text">
                        Brindar herramientas prácticas como cálculo de IMC, rutinas personalizadas y control
                        de hábitos para un progreso constante.
                    </p>
                </div>
            </div>
        </div>
    </div>


    <div class="mt-5 text-center">
        <h2 class="fw-bold mb-4">👥 Nuestro Equipo</h2>
        <p class="text-muted">
            WorldFit es desarrollado por un grupo apasionado de estudiantes y profesionales
            dedicados a la salud, la tecnología y el bienestar.
        </p>
        <img src="~/Content/img/equipo.jpeg" alt="Equipo WorldFit" class="img-fluid rounded shadow mt-3" style="max-width:400px;" />
    </div>
</div>
