@{
    ViewBag.Title = "Contáctanos - WorldFit";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-success">📩 Contáctanos</h1>
        <p class="lead text-muted">¿Tienes dudas o sugerencias? Estamos aquí para ayudarte.</p>
    </div>

    <div class="row">
       
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-success mb-3">Información</h4>
                    <p><strong>Dirección:</strong> Av. Uruguay 514, Lima - Perú</p>
                    <p><strong>Teléfono:</strong> 📞 +51 987 654 321</p>
                    <p><strong>Email:</strong> <a href="mailto:soporte@worldfit.com">soporte@worldfit.com</a></p>
                    <p><strong>Horario de atención:</strong> Lunes a Viernes 9am - 6pm</p>
                </div>
            </div>
        </div>

        
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4 class="card-title text-primary mb-3">Envíanos un mensaje</h4>
                    @using (Html.BeginForm("EnviarMensaje", "Usuario", FormMethod.Post))
                    {
                        <div class="form-group mb-3">
                            <label for="nombre">Nombre</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Tu nombre" required />
                        </div>

                        <div class="form-group mb-3">
                            <label for="correo">Correo</label>
                            <input type="email" name="correo" class="form-control" placeholder="Tu correo" required />
                        </div>

                        <div class="form-group mb-3">
                            <label for="mensaje">Mensaje</label>
                            <textarea name="mensaje" class="form-control" rows="4" placeholder="Escribe tu mensaje aquí..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Enviar</button>
                    }
                </div>
            </div>
        </div>
    </div>

    
    <div class="mt-5">
        <h4 class="fw-bold mb-3">📍 Encuéntranos</h4>
        <div class="ratio ratio-16x9">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3900.768!2d-77.0428!3d-12.0464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDAyJzQ3LjAiUyA3N8KwMDInMzMuMCJX!5e0!3m2!1ses-419!2spe!4v1234567890"
                    width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </div>
</div>