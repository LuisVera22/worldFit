@model List<Dominio.Entidad.Entidad.Imc>

@{
    int pageIMC = ViewBag.PageIMC ?? 1;
    int totalPagesIMC = ViewBag.TotalPagesIMC ?? 0;
}

@if (Model != null && Model.Count > 0)
{
    <div class="table-responsive mt-3">
        <table class="table table-hover table-striped align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>Peso (kg.)</th>
                    <th>Altura (cm)</th>
                    <th>IMC</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.peso</td>
                        <td>@item.altura</td>
                        <td class="fw-semibold">@item.valorIMC</td>
                        <td>@item.fechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN IMC (AJAX) -->
    if (totalPagesIMC > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">

                <li class="page-item @(pageIMC == 1 ? "disabled" : "")">
                    <a class="page-link imc-page-link"
                       data-page="@(pageIMC - 1)">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPagesIMC; i++)
                {
                    <li class="page-item @(i == pageIMC ? "active" : "")">
                        <a class="page-link imc-page-link" data-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(pageIMC == totalPagesIMC ? "disabled" : "")">
                    <a class="page-link imc-page-link"
                       data-page="@(pageIMC + 1)">Siguiente</a>
                </li>

            </ul>
        </nav>
    }
}
else
{
    <p class="text-muted">Aún no tienes cálculos registrados.</p>
}

