@model Dominio.Entidad.Entidad.Usuario

@{
    ViewBag.Title = "Registro";
}

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-5">
                    <h2 class="text-center fw-bold text-primary mb-4">Registro de Usuario</h2>
                    <p class="text-center text-muted mb-4">Crea tu cuenta para acceder a todas las funcionalidades</p>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <!--<div class="mb-3">
                            @Html.LabelFor(model => model.IdUsuario, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.IdUsuario, new { @class = "form-control", placeholder = "Ej: 1001" })
                            @Html.ValidationMessageFor(model => model.IdUsuario, "", new { @class = "text-danger small" })
                        </div>-->

                        <div class="mb-3">
                            @Html.LabelFor(model => model.correo, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.correo, new { @class = "form-control", placeholder = "correo@ejemplo.com", type = "email" })
                            @Html.ValidationMessageFor(model => model.correo, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.clave, new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(model => model.clave, new { @class = "form-control", placeholder = "******" })
                            @Html.ValidationMessageFor(model => model.clave, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.nombre, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", placeholder = "Tu nombre completo" })
                            @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.telefono, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.telefono, new { @class = "form-control", placeholder = "999-999-999" })
                            @Html.ValidationMessageFor(model => model.telefono, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.fechaNacimiento, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(model => model.fechaNacimiento, new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(model => model.fechaNacimiento, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.genero, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(model => model.genero,
                                new SelectList(new[] { "Masculino", "Femenino", "Otro" }),
                                "Seleccione género",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.genero, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Registrar</button>
                        </div>
                    }

                    <div class="text-center mt-4">
                        @Html.ActionLink("⬅ Ir a inicio", "Index", null, new { @class = "btn btn-link text-decoration-none" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success text-center fw-semibold">
        @TempData["Mensaje"]
    </div>
}