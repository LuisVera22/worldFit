@{
    ViewBag.Title = "Iniciar Sesión";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-4">
        <div class="card p-4 shadow-lg border-0 rounded-3">
            <h2 class="text-center mb-4 text-primary">Iniciar Sesión</h2>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Mensaje</div>
            }

            @using (Html.BeginForm("Login", "Usuario", FormMethod.Post))
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Correo</label>
                    <input type="email" name="correo" class="form-control" placeholder="Ingrese su correo" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input type="password" name="clave" class="form-control" placeholder="Ingrese su contraseña" required />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg fw-bold">Ingresar</button>
                </div>
            }

            <p class="mt-3 text-center">
                ¿No tienes cuenta? @Html.ActionLink("Regístrate aquí", "Registro", "Usuario", null, new { @class = "fw-semibold text-decoration-none" })
            </p>
        </div>
    </div>
</div>