
@model List<Dominio.Entidad.Entidad.Habito>

@{
    int pageHabitos = ViewBag.PageHabitos ?? 1;
    int totalPagesHabitos = ViewBag.TotalPagesHabitos ?? 0;
}

@if (Model != null && Model.Count > 0)
{
    <div class="table-responsive mt-3">
        <table class="table table-hover table-striped text-center align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Pasos</th>
                    <th>Sueño</th>
                    <th>Agua</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>@h.fechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>@h.pasos</td>
                        <td>@h.horasSueno</td>
                        <td>@h.vasosAgua</td>
                        <td class="text-start">@h.notas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN HÁBITOS (AJAX) -->
    if (totalPagesHabitos > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">

                <li class="page-item @(pageHabitos == 1 ? "disabled" : "")">
                    <a class="page-link habito-page-link"
                       data-page="@(pageHabitos - 1)">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPagesHabitos; i++)
                {
                    <li class="page-item @(i == pageHabitos ? "active" : "")">
                        <a class="page-link habito-page-link" data-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(pageHabitos == totalPagesHabitos ? "disabled" : "")">
                    <a class="page-link habito-page-link"
                       data-page="@(pageHabitos + 1)">Siguiente</a>
                </li>

            </ul>
        </nav>
    }
}
else
{
    <p class="text-muted">No tienes hábitos registrados todavía.</p>
}
