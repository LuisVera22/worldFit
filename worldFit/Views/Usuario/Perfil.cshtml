@{
    ViewBag.Title = "Perfil de Usuario";
}

<div class="container p-5 profile-light">

    <!-- PERFIL -->
    <div class="card p-4 border-0 light-card mb-4">
        <h2 class="fw-bold text-dark mb-1">👤 Bienvenido, @ViewBag.Nombre</h2>
        <p class="text-muted mb-2">@ViewBag.Correo</p>

        <div class="d-flex gap-2 flex-wrap mt-2">
            <a href="@Url.Action("Calculadora", "Calculadora")" class="btn btn-primary light-btn">
                <i class="bi bi-calculator"></i> Calcular IMC
            </a>
            <a href="@Url.Action("MisHabitos", "Habito")" class="btn btn-outline-primary light-btn-outline">
                <i class="bi bi-plus-circle"></i> Registrar Hábito
            </a>
        </div>
    </div>

    <!-- HISTORIAL IMC -->
    <div class="card p-4 border-0 light-card mb-4">
        <h4 class="fw-bold text-dark">📊 Historial de IMC</h4>

        <div id="imc-container">
            @Html.Action("HistorialIMC", "Usuario", new { pageIMC = 1 })
        </div>
    </div>

    <!-- HÁBITOS -->
    <div class="card p-4 border-0 light-card mb-4">
        <h4 class="fw-bold text-dark">🧘‍♀️ Hábitos Registrados</h4>

        <div id="habitos-container">
            @Html.Action("Habitos", "Usuario", new { pageHabitos = 1 })
        </div>
    </div>

</div>

@section Scripts {

    <script>
        // Paginación AJAX para IMC
        $(document).on("click", ".imc-page-link", function (e) {
            e.preventDefault();

            var page = $(this).data("page");
            if (!page || page < 1) return;

            $.get("@Url.Action("HistorialIMC", "Usuario")", { pageIMC: page })
                .done(function (html) {
                    $("#imc-container").html(html);
                });
        });

        // Paginación AJAX para Hábitos
        $(document).on("click", ".habito-page-link", function (e) {
            e.preventDefault();

            var page = $(this).data("page");
            if (!page || page < 1) return;

            $.get("@Url.Action("Habitos", "Usuario")", { pageHabitos: page })
                .done(function (html) {
                    $("#habitos-container").html(html);
                });
        });
    </script>
}
