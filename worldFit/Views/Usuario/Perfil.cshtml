@section Scripts {

    <script>
        // Paginación AJAX para IMC
        $(document).on("click", ".imc-page-link", function (e) {
            e.preventDefault();

            var page = $(this).data("page");
            if (!page || page < 1) return;

            $.get("@Url.Action("HistorialIMC", "Usuario")", { pageIMC: page })
                .done(function (html) {
                    $("#imc-container").html(html);
                });
        });

        // Paginación AJAX para Hábitos
        $(document).on("click", ".habito-page-link", function (e) {
            e.preventDefault();

            var page = $(this).data("page");
            if (!page || page < 1) return;

            $.get("@Url.Action("Habitos", "Usuario")", { pageHabitos: page })
                .done(function (html) {
                    $("#habitos-container").html(html);
                });
        });
    </script>
}
