@using System.Collections.Generic
@using Dominio.Entidad.Entidad

@{
    ViewBag.Title = "Perfil de Usuario";

    var historial = ViewBag.Historial as List<Imc>;
    var habitos = ViewBag.Habitos as List<Habito>;
    var rutinas = ViewBag.Rutinas as List<UsuarioRutina>;

    int paginaActualHistorial = ViewBag.HistorialPaginaActual != null ? (int)ViewBag.HistorialPaginaActual : 1;
    int totalPaginasHistorial = ViewBag.HistorialTotalPaginas != null ? (int)ViewBag.HistorialTotalPaginas : 1;

    int paginaActualHabitos = ViewBag.HabitosPaginaActual != null ? (int)ViewBag.HabitosPaginaActual : 1;
    int totalPaginasHabitos = ViewBag.HabitosTotalPaginas != null ? (int)ViewBag.HabitosTotalPaginas : 1;
}

<div class="container p-5 profile-light">

    <!-- PERFIL -->
    <div class="card p-4 border-0 light-card mb-4">
        <h2 class="fw-bold text-dark mb-1">👤 Bienvenido, @ViewBag.Nombre</h2>
        <p class="text-muted mb-2">@ViewBag.Correo</p>

        <div class="d-flex gap-2 flex-wrap mt-2">
            <a href="@Url.Action("Calculadora", "Calculadora")" class="btn btn-primary light-btn">
                <i class="bi bi-calculator"></i> Calcular IMC
            </a>
            <a href="@Url.Action("MisHabitos", "Habito")" class="btn btn-outline-primary light-btn-outline">
                <i class="bi bi-plus-circle"></i> Registrar Hábito
            </a>
        </div>
    </div>

    <!-- HISTORIAL IMC -->
    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-primary fw-bold">📊 Historial de IMC</h4>

        @if (historial != null && historial.Any())
        {
            <table class="table table-striped mt-3 text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Peso (kg)</th>
                        <th>Altura (cm)</th>
                        <th>IMC</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in historial)
                    {
                        <tr>
                            <td>@item.peso</td>
                            <td>@item.altura</td>
                            <td>@item.imcCalculado</td>
                            <td>@item.fechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Paginación Historial IMC -->
            <nav aria-label="Paginación historial IMC">
                <ul class="pagination justify-content-center">

                    <!-- Anterior -->
                    <li class="page-item @(paginaActualHistorial == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Perfil", new { historialPage = paginaActualHistorial - 1, habitosPage = paginaActualHabitos })">
                            «
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginasHistorial; i++)
                    {
                        <li class="page-item @(i == paginaActualHistorial ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Perfil", new { historialPage = i, habitosPage = paginaActualHabitos })">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Siguiente -->
                    <li class="page-item @(paginaActualHistorial == totalPaginasHistorial ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Perfil", new { historialPage = paginaActualHistorial + 1, habitosPage = paginaActualHabitos })">
                            »
                        </a>
                    </li>

                </ul>
            </nav>
        }
        else
        {
            <p class="text-muted">Aún no tienes cálculos de IMC registrados.</p>
        }
    </div>

    <!-- HÁBITOS -->
    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-success fw-bold">🧘‍♀️ Hábitos Registrados</h4>

        @if (habitos != null && habitos.Any())
        {
            <table class="table table-striped mt-3 text-center align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Fecha</th>
                        <th>Pasos</th>
                        <th>Horas de Sueño</th>
                        <th>Vasos de Agua</th>
                        <th>Notas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in habitos)
                    {
                        <tr>
                            <td>@h.fechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>@h.pasos</td>
                            <td>@h.horasSueno</td>
                            <td>@h.vasosAgua</td>
                            <td>@h.notas</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Paginación Hábitos -->
            <nav aria-label="Paginación hábitos">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(paginaActualHabitos == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Perfil", new { historialPage = paginaActualHistorial, habitosPage = paginaActualHabitos - 1 })">
                            «
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginasHabitos; i++)
                    {
                        <li class="page-item @(i == paginaActualHabitos ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Perfil", new { historialPage = paginaActualHistorial, habitosPage = i })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActualHabitos == totalPaginasHabitos ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Perfil", new { historialPage = paginaActualHistorial, habitosPage = paginaActualHabitos + 1 })">
                            »
                        </a>
                    </li>

                </ul>
            </nav>
        }
        else
        {
            <p class="text-muted">No tienes hábitos registrados todavía.</p>
        }
    </div>

    <!-- RUTINAS ASIGNADAS -->
    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-success fw-bold">🏋️‍♂️ Rutinas Asignadas</h4>

        @if (rutinas != null && rutinas.Any())
        {
            <div class="row mt-3">
                @foreach (var r in rutinas)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body text-center">
                                <h5 class="fw-bold text-primary">@r.nombreRutina</h5>
                                <p><strong>Meta semanal:</strong> @r.metaSemanal días</p>
                                <p><strong>Días cumplidos:</strong> @r.diasCumplidos</p>
                                <p><strong>Fecha asignación:</strong> @r.fechaAsignacion.ToShortDateString()</p>

                                <!-- MOSTRAR EJERCICIOS DE LA RUTINA -->
                                <button class="btn btn-outline-primary btn-sm mt-2"
                                        onclick="cargarEjercicios(@r.idRutina, '@r.nombreRutina')">
                                    🏋️ Ver ejercicios
                                </button>

                            </div>

                            <div class="card-footer text-center bg-light">
                                <a href="@Url.Action("ActualizarProgreso", "UsuarioRutina", new { idUsuarioRutina = r.idUsuarioRutina })"
                                   class="btn btn-outline-success btn-sm">
                                    ✅ Día completado
                                </a>

                                <a href="@Url.Action("Eliminar", "UsuarioRutina", new { idUsuarioRutina = r.idUsuarioRutina })"
                                   class="btn btn-outline-danger btn-sm ms-2">
                                    ❌ Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No tienes rutinas asignadas todavía.</p>
        }
    </div>

    <!-- MODAL: EJERCICIOS DE LA RUTINA -->
    <div class="modal fade" id="modalEjercicios" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="tituloModalEjercicios">Ejercicios</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" id="contenidoEjercicios">
                    <p class="text-center text-muted">Cargando ejercicios...</p>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="container mt-4">
    <script>
        function cargarEjercicios(idRutina, nombreRutina) {

            document.getElementById("tituloModalEjercicios").innerText =
                "Ejercicios de la rutina: " + nombreRutina;

            var modal = new bootstrap.Modal(document.getElementById('modalEjercicios'));
            modal.show();

            document.getElementById("contenidoEjercicios").innerHTML =
                "<p class='text-center text-muted'>Cargando ejercicios...</p>";

            fetch('/Rutina/ObtenerEjercicios?idRutina=' + idRutina)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("contenidoEjercicios").innerHTML = html;
                });
        }

        function eliminarEjercicio(idEjercicioUsuario) {

            if (!confirm("¿Eliminar este ejercicio de tu rutina?")) return;

            fetch('/Rutina/EliminarEjercicioUsuario?idEjercicioUsuario=' + idEjercicioUsuario)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("row-" + idEjercicioUsuario).remove();
                    }
                });
        }
    </script>
</div>
