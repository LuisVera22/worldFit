@{
    ViewBag.Title = "Perfil de Usuario";
    var historial = ViewBag.Historial as List<Dominio.Entidad.Entidad.Imc>;
    var habitos = ViewBag.Habitos as List<Dominio.Entidad.Entidad.Habito>;
}

<div class="container mt-4">


    <div class="card shadow-lg p-4 border-0">
        <h2 class="text-center text-primary fw-bold">👤 Bienvenido, @ViewBag.Nombre</h2>
        <hr />
        <p><strong>Correo:</strong> @ViewBag.Correo</p>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="@Url.Action("Calculadora", "Calculadora")" class="btn btn-primary">
                <i class="bi bi-calculator"></i> Calcular IMC
            </a>
            <a href="@Url.Action("MisHabitos", "Habito")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Registrar Hábito
            </a>
            <a href="@Url.Action("Logout", "Usuario")" class="btn btn-danger">
                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
            </a>
        </div>
    </div>


    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-primary fw-bold">📊 Historial de IMC</h4>

        @if (historial != null && historial.Count > 0)
        {
            <table class="table table-striped mt-3 text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Peso (kg)</th>
                        <th>Altura (cm)</th>
                        <th>IMC</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in historial)
                    {
                        <tr>
                            <td>@item.peso</td>
                            <td>@item.altura</td>
                            <td>@item.valorIMC</td>
                            <td>@item.fechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Aún no tienes cálculos de IMC registrados.</p>
        }
    </div>


    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-success fw-bold">🧘‍♀️ Hábitos Registrados</h4>

        @if (habitos != null && habitos.Count > 0)
        {
            <table class="table table-striped mt-3 text-center align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Fecha</th>
                        <th>Pasos</th>
                        <th>Horas de Sueño</th>
                        <th>Vasos de Agua</th>
                        <th>Notas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in habitos)
                    {
                        <tr>
                            <td>@h.fechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>@h.pasos</td>
                            <td>@h.horasSueno</td>
                            <td>@h.vasosAgua</td>
                            <td>@h.notas</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No tienes hábitos registrados todavía.</p>
        }
    </div>

    <div class="card shadow mt-4 p-4 border-0">
        <h4 class="text-success fw-bold">🏋️‍♂️ Rutinas Asignadas</h4>

        @if (ViewBag.Rutinas != null && ((List<Dominio.Entidad.Entidad.UsuarioRutina>)ViewBag.Rutinas).Count > 0)
        {
            var rutinas = (List<Dominio.Entidad.Entidad.UsuarioRutina>)ViewBag.Rutinas;

            <div class="row mt-3">
                @foreach (var r in rutinas)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body text-center">
                                <h5 class="fw-bold text-primary">@r.nombreRutina</h5>
                                <p><strong>Meta semanal:</strong> @r.metaSemanal días</p>
                                <p><strong>Días cumplidos:</strong> @r.diasCumplidos</p>
                                <p><strong>Fecha asignación:</strong> @r.fechaAsignacion.ToShortDateString()</p>
                            </div>

                            <div class="card-footer text-center bg-light">
                                <a href="@Url.Action("ActualizarProgreso", "UsuarioRutina", new { idUsuarioRutina = r.idUsuarioRutina })"
                                   class="btn btn-outline-success btn-sm">
                                    ✅ Día completado
                                </a>

                                <a href="@Url.Action("Eliminar", "UsuarioRutina", new { idUsuarioRutina = r.idUsuarioRutina })"
                                   class="btn btn-outline-danger btn-sm ms-2">
                                    ❌ Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No tienes rutinas asignadas todavía.</p>
        }
    </div>


</div>
