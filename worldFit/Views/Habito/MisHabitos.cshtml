@model IEnumerable<Dominio.Entidad.Entidad.Habito>

@{
    ViewBag.Title = "Mis Hábitos";
    var habitos = Model.OrderByDescending(h => h.fechaRegistro).ToList();
    var tieneHabitos = habitos.Any();
}

<main class="container py-4 habits-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold habits-title mb-1">Mis hábitos registrados</h2>
            <p class="habits-subtitle mb-0">Tu progreso diario en pasos, sueño y agua.</p>
        </div>
    </div>

    <!-- SI NO HAY REGISTROS -->
    @if (!tieneHabitos)
    {
        <div class="card habits-card text-center p-4 mb-4">
            <p class="text-muted">Aún no has registrado ningún hábito.</p>
            @Html.ActionLink("Comenzar ahora", "Registrar", null, new { @class = "btn habits-btn-primary mt-3" })
        </div>
    }
    else
    {
        <!-- GRID DE HÁBITOS -->
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var h in habitos)
            {
                <div class="col">
                    <div class="card habits-card h-100">
                        <div class="card-body">

                            <!-- Fecha -->
                            <div class="mb-2">
                                <span class="habits-badge">📅 @h.fechaRegistro.ToString("dd/MM/yyyy")</span>
                            </div>

                            <!-- Datos -->
                            <ul class="list-unstyled mb-2">
                                <li class="mb-1">
                                    <span class="habits-label">Pasos:</span>
                                    <span class="habits-value">@h.pasos</span>
                                </li>
                                <li class="mb-1">
                                    <span class="habits-label">Horas de sueño:</span>
                                    <span class="habits-value">@h.horasSueno</span>
                                </li>
                                <li class="mb-1">
                                    <span class="habits-label">Vasos de agua:</span>
                                    <span class="habits-value">@h.vasosAgua</span>
                                </li>
                            </ul>

                            @if (!string.IsNullOrWhiteSpace(h.notas))
                            {
                                <p class="text-muted small mb-0">@h.notas</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ACCIONES INFERIORES -->
        <div class="d-flex justify-content-center gap-2 mt-4">
            @Html.ActionLink("Registrar nuevo hábito", "Registrar", null,
                new { @class = "btn habits-btn-primary" })

            @Html.ActionLink("Volver", "Perfil", "Usuario", null,
                new { @class = "btn habits-btn-outline" })
        </div>
    }
</main>