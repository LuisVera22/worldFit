@{
    ViewBag.Title = "Calcular IMC";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h3 class="mb-3 text-primary">Calcular tu IMC</h3>

        @using (Html.BeginForm("Registrar", "Calculadora", FormMethod.Post))
        {
            <div class="form-group mb-3">
                <label>Peso (kg):</label>
                <input type="number" step="0.01" name="peso" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label>Altura (cm):</label>
                <input type="number" step="0.01" name="altura" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Calcular y Guardar</button>
        }

        @if (ViewBag.IMC != null)
        {
            <div class="alert alert-info mt-4 text-center">
                <h5>@ViewBag.Mensaje</h5>
            </div>

            <div class="progress mt-3">
                <div class="progress-bar
                    @(ViewBag.Estado == "Bajo peso" ? "bg-secondary" :
                      ViewBag.Estado == "Peso normal" ? "bg-success" :
                      ViewBag.Estado == "Sobrepeso" ? "bg-warning" : "bg-danger")"
                     role="progressbar"
                     style="width:@(Math.Min((double)ViewBag.IMC * 3, 100))%">
                </div>
            </div>

            <div class="text-center mt-3">
                @Html.ActionLink("Ver historial de IMC", "Historial", "Calculadora", null, new { @class = "btn btn-outline-primary" })
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3">@ViewBag.Error</div>
        }
    </div>
</div>